#. Plugin Name of the plugin
#: pagelean.php
msgid "Pagelean - Conditional Script and Style Loading"
msgstr "Pagelean - Bedingtes Laden von Skripten und Stilen"

#. Plugin URI of the plugin
#: pagelean.php
msgid "https://plogins.com/pagelean/"
msgstr "https://plogins.com/pagelean/"

#. Description of the plugin
#: pagelean.php
msgid ""
"Dequeue individual scripts and styles on the pages that do not need them. "
"Fewer requests, lighter pages, faster loads - using WordPress core, no page "
"builder lock-in."
msgstr ""
"Entferne einzelne Skripte und Stile aus der Warteschlange auf den Seiten, "
"die sie nicht benötigen. Weniger Anfragen, schlankere Seiten, schnellere "
"Ladevorgänge, mit WordPress-Kern, keine Bindung an den Seitenersteller."

#. Author of the plugin
#: pagelean.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
