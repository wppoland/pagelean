#. Plugin Name of the plugin
#: pagelean.php
msgid "Pagelean - Conditional Script and Style Loading"
msgstr "Pagelean - carga de estilos y secuencias de comandos condicionales"

#. Plugin URI of the plugin
#: pagelean.php
msgid "https://plogins.com/pagelean/"
msgstr "https://plogins.com/pagelean/"

#. Description of the plugin
#: pagelean.php
msgid ""
"Dequeue individual scripts and styles on the pages that do not need them. "
"Fewer requests, lighter pages, faster loads - using WordPress core, no page "
"builder lock-in."
msgstr ""
"Retire de la cola scripts y estilos individuales en las páginas que no los "
"necesitan. Menos solicitudes, páginas más ligeras, cargas más rápidas: "
"utilizando el núcleo de WordPress, sin bloqueo del creador de páginas."

#. Author of the plugin
#: pagelean.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
