#. Plugin Name of the plugin
#: pagelean.php
msgid "Pagelean - Conditional Script and Style Loading"
msgstr "Pagelean - warunkowe ładowanie skryptu i stylu"

#. Plugin URI of the plugin
#: pagelean.php
msgid "https://plogins.com/pagelean/"
msgstr "https://plogins.com/pagelean/"

#. Description of the plugin
#: pagelean.php
msgid ""
"Dequeue individual scripts and styles on the pages that do not need them. "
"Fewer requests, lighter pages, faster loads - using WordPress core, no page "
"builder lock-in."
msgstr ""
"Usuń z kolejki poszczególne skrypty i style na stronach, które ich nie "
"potrzebują. Mniej żądań, lżejsze strony, szybsze ładowanie - przy użyciu "
"rdzenia WordPress, bez blokady narzędzia do tworzenia stron."

#. Author of the plugin
#: pagelean.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
